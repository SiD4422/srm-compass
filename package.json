{
  "name": "srm-compass",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "verify": "tsx scripts/verify.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --exclude '**/axe-all-pages.test.ts' --exclude '**/functional-harness.test.ts'",
    "test:e2e": "vitest run tests/axe-all-pages.test.ts tests/functional-harness.test.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
